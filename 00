-- ================================================
-- Universal Script (Fly, NoClip, Semi-Invisible, Speed, Godmode)
-- ================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- ลบ UI เก่าออกถ้ามี
if game.CoreGui:FindFirstChild("UniversalLiteUI") then
    game.CoreGui.UniversalLiteUI:Destroy()
end

-- สร้าง UI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "UniversalLiteUI"
ScreenGui.Parent = game.CoreGui

local Frame = Instance.new("Frame")
Frame.Parent = ScreenGui
Frame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
Frame.Position = UDim2.new(0.05, 0, 0.2, 0)
Frame.Size = UDim2.new(0, 210, 0, 270)
Frame.Active = true
Frame.Draggable = true

local Title = Instance.new("TextLabel")
Title.Parent = Frame
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
Title.Text = "⚡ Universal Hub (Semi-Invis)"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 13
Title.Font = Enum.Font.SourceSansBold

local UIList = Instance.new("UIListLayout")
UIList.Parent = Frame
UIList.SortOrder = Enum.SortOrder.LayoutOrder
UIList.Padding = UDim.new(0, 5)

local function makeBtn(text)
    local b = Instance.new("TextButton")
    b.Parent = Frame
    b.Size = UDim2.new(0.9, 0, 0, 32)
    b.Position = UDim2.new(0.05, 0, 0, 0)
    b.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    b.Text = text .. ": ปิด"
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Font = Enum.Font.SourceSans
    b.TextSize = 13
    return b
end

-- 1. ปุ่มบิน (Fly)
local flyBtn = makeBtn("🚀 บิน (Fly)")
local flying = false
local bv, bg

flyBtn.MouseButton1Click:Connect(function()
    flying = not flying
    flyBtn.Text = "🚀 บิน (Fly): " .. (flying and "เปิด" or "ปิด")
    flyBtn.BackgroundColor3 = flying and Color3.fromRGB(120, 70, 240) or Color3.fromRGB(45, 45, 60)
    
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    if flying then
        bv = Instance.new("BodyVelocity", hrp)
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bg = Instance.new("BodyGyro", hrp)
        bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        
        task.spawn(function()
            while flying and char and hrp do
                local cam = workspace.CurrentCamera
                local dir = Vector3.new()
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0,1,0) end
                
                bv.Velocity = dir * 60
                bg.CFrame = cam.CFrame
                RunService.RenderStepped:Wait()
            end
        end)
    else
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
    end
end)

-- 2. ปุ่มเดินทะลุ (NoClip)
local noclipBtn = makeBtn("🧱 เดินทะลุ (NoClip)")
local noclip = false
noclipBtn.MouseButton1Click:Connect(function()
    noclip = not noclip
    noclipBtn.Text = "🧱 เดินทะลุ: " .. (noclip and "เปิด" or "ปิด")
    noclipBtn.BackgroundColor3 = noclip and Color3.fromRGB(120, 70, 240) or Color3.fromRGB(45, 45, 60)
end)

RunService.Stepped:Connect(function()
    if noclip and LocalPlayer.Character then
        for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
end)

-- 3. ปุ่มวิ่งเร็ว (Speed)
local speedBtn = makeBtn("⚡ วิ่งเร็ว (Speed)")
local speedOn = false
speedBtn.MouseButton1Click:Connect(function()
    speedOn = not speedOn
    speedBtn.Text = "⚡ วิ่งเร็ว: " .. (speedOn and "เปิด" or "ปิด")
    speedBtn.BackgroundColor3 = speedOn and Color3.fromRGB(120, 70, 240) or Color3.fromRGB(45, 45, 60)
    
    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = speedOn and 100 or 16
    end
end)

-- 4. ปุ่มล่องหนแบบเห็นตัวลางๆ (Semi-Invisible 0.7)
local invisBtn = makeBtn("👻 หายตัวลางๆ (Invis)")
local isInvis = false
invisBtn.MouseButton1Click:Connect(function()
    isInvis = not isInvis
    invisBtn.Text = "👻 หายตัวลางๆ: " .. (isInvis and "เปิด" or "ปิด")
    invisBtn.BackgroundColor3 = isInvis and Color3.fromRGB(120, 70, 240) or Color3.fromRGB(45, 45, 60)
    
    if LocalPlayer.Character then
        for _, p in pairs(LocalPlayer.Character:GetDescendants()) do
            if (p:IsA("BasePart") or p:IsA("Decal")) and p.Name ~= "HumanoidRootPart" then
                p.Transparency = isInvis and 0.7 or 0 -- ปรับโปร่งใส 0.7 พอเห็นตัวลางๆ
            end
        end
    end
end)

-- 5. ปุ่มอมตะ (Godmode)
local godBtn = makeBtn("🛡️ อมตะ (Godmode)")
local isGod = false
godBtn.MouseButton1Click:Connect(function()
    isGod = not isGod
    godBtn.Text = "🛡️ อมตะ: " .. (isGod and "เปิด" or "ปิด")
    godBtn.BackgroundColor3 = isGod and Color3.fromRGB(120, 70, 240) or Color3.fromRGB(45, 45, 60)
    
    task.spawn(function()
        while isGod do
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = hum.MaxHealth end
            task.wait(0.1)
        end
    end)
end)
